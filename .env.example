# --- Base de données MariaDB ---
# Sur le mutualisé : socket UNIX (chemin donné par l'hébergeur, souvent /var/run/mysqld/mysqld.sock)
DB_SOCKET=/var/run/mysqld/mysqld.sock
# Ou en TCP si pas de socket : DB_HOST=127.0.0.1 / DB_PORT=3306 (le socket a priorité s'il est défini)
DB_HOST=
DB_PORT=3306
DB_NAME=firemap
DB_USER=firemap
DB_PASS=changeme

# --- Serveur ---
PORT=3000
# URL publique (pour les liens de partage et le QR) — ex: https://entraide.mondomaine.fr
BASE_URL=http://localhost:3000
# Email de contact (obligatoire pour le push VAPID + mentions légales)
CONTACT_EMAIL=h2co3_official@protonmail.com

# --- Optionnel : générés automatiquement dans data/ au premier démarrage si absents ---
# SECRET=            (clé HMAC des cookies)
# ADMIN_KEY=         (clé d'accès à /admin.html)
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
